{
  "name": "gridsong",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "pretest:api": "npm --prefix api ci --ignore-scripts",
    "test:api": "npm --prefix api run test --",
    "test:e2e": "playwright test",
    "test:live": "node scripts/live-api-smoke.mjs && node scripts/live-gallery-flow.mjs && node scripts/live-gallery-capacity.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.58.2",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
